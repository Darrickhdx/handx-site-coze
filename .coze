[project]
requires = [ "nodejs-24" ]
project_type = "web"
template = "nextjs"
version = "0.0.32"
appliedPatches = [ ]

[dev]
build = [ "bash", "./scripts/prepare.sh" ]
run = [ "bash", "./scripts/dev.sh" ]
validate = [ "bash", "./scripts/validate.sh" ]
deps = [ "git" ]

# Deploy runs the public edition. scripts/build.sh and scripts/start.sh remain
# the workbench lane and keep refusing COZE_PROJECT_ENV=PROD; pointing deploy at
# them is what made deployment impossible by construction.
[deploy]
build = [ "bash", "./scripts/build-public.sh" ]
run = [ "bash", "./scripts/start-public.sh" ]
deps = [ "git" ]
